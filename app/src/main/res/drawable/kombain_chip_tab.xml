<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="3dp" android:insetRight="3dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="18dp" />
                <solid android:color="@color/kombain_card" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="3dp" android:insetRight="3dp" android:insetTop="2dp" android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="18dp" />
                <solid android:color="@color/kombain_tile" />
                <stroke android:width="1dp" android:color="@color/kombain_tile_stroke" />
            </shape>
        </inset>
    </item>
</selector>
