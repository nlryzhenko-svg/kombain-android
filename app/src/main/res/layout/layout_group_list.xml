<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.ConfigurationFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include layout="@layout/layout_status_card" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/group_tab"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:elevation="0dp"
        android:visibility="gone"
        android:layout_marginStart="12dp"
        app:tabBackground="@drawable/kombain_chip_tab"
        app:tabGravity="start"
        app:tabIndicator="@null"
        app:tabIndicatorHeight="0dp"
        app:tabMinWidth="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="18dp"
        app:tabPaddingStart="18dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@color/kombain_on_card"
        app:tabTextAppearance="@style/TextAppearance.Kombain.Chip"
        app:tabTextColor="@color/kombain_text2" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/group_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>