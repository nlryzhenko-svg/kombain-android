+// AmneziaOptions carries AmneziaWG obfuscation parameters. All zero = plain WireGuard.
+type AmneziaOptions struct {
+	Jc   int
+	Jmin int
+	Jmax int
+	S1   int
+	S2   int
+	S3   int
+	S4   int
+	H1   string
+	H2   string
+	H3   string
+	H4   string
+	I1   string
+	I2   string
+	I3   string
+	I4   string
+	I5   string
+}
+
+func (o AmneziaOptions) IpcLines() string {
+	var b strings.Builder
+	num := func(k string, v int) {
+		if v != 0 {
+			b.WriteString("\n" + k + "=" + strconv.Itoa(v))
+		}
+	}
+	str := func(k string, v string) {
+		v = strings.TrimSpace(v)
+		if v != "" {
+			b.WriteString("\n" + k + "=" + v)
+		}
+	}
+	num("jc", o.Jc)
+	num("jmin", o.Jmin)
+	num("jmax", o.Jmax)
+	num("s1", o.S1)
+	num("s2", o.S2)
+	num("s3", o.S3)
+	num("s4", o.S4)
+	str("h1", o.H1)
+	str("h2", o.H2)
+	str("h3", o.H3)
+	str("h4", o.H4)
+	str("i1", o.I1)
+	str("i2", o.I2)
+	str("i3", o.I3)
+	str("i4", o.I4)
+	str("i5", o.I5)
+	return b.String()
 }
 
